# ============================================================
# Required: Mainnet Configuration
# ============================================================

# L1 RPC URL (supports comma-separated URLs for automatic failover)
VITE_L1_RPC_URL=https://1rpc.io/eth
VITE_TALLY_PROPOSER_ADDRESS=0xa4a38fD0108C00983E75616b638Ff3321FD26958
VITE_SLASHER_ADDRESS=0x64E6e9Bb9f1E33D319578B9f8a9C719Ca6D46eBb
VITE_ROLLUP_ADDRESS=0xAe2001f7e21d5EcABf6234E9FDd1E76F50F74962

# Node Admin API (optional)
# If not set, the app will work but won't show detailed offense classifications
# VITE_NODE_ADMIN_URL=http://localhost:8880

# testnet
VITE_TESTNET_L1_RPC_URL=https://0xrpc.io/sep
VITE_TESTNET_TALLY_PROPOSER_ADDRESS=0xcA49e32bc2926c3F2Ef67E1647Fa14a8ebf34065
VITE_TESTNET_SLASHER_ADDRESS=0x89684502e6A5fD3f1e4B3C610429F6E2C181c6ba
VITE_TESTNET_ROLLUP_ADDRESS=0x66A41CB55F9a1e38A45A2Ac8685F12A61fBFab77
# VITE_TESTNET_NODE_ADMIN_URL=http://localhost:8880

# ============================================================
# Performance & Behavior Configuration (Optional)
# All values below have sensible defaults and can be omitted
# ============================================================

# Polling & Update Intervals (in milliseconds)
# VITE_L2_POLL_INTERVAL=180000              # Background poll interval (default: 3 minutes, ~10 polls per 30min round)
# VITE_REALTIME_COUNTDOWN_INTERVAL=1000     # Countdown timer update interval (default: 1 second)

# Historical Data Configuration
# VITE_LOOKBACK_ROUNDS=100                  # Number of rounds to look back from current (default: 0 = only scan active window)
# VITE_TESTNET_LOOKBACK_ROUNDS=100          # Testnet override for lookback rounds (optional)

# Cache Configuration (in milliseconds)
# Uses immutability-aware caching: executed rounds are cached forever, active rounds use TTL
# VITE_L1_ROUND_CACHE_TTL=120000            # L1 round cache TTL for mutable rounds (default: 2 minutes)
# VITE_DETAILS_CACHE_TTL=300000             # Slashing details cache TTL for mutable rounds (default: 5 minutes)

# UI/UX Configuration
# VITE_COPY_FEEDBACK_DURATION=2000          # Copy button feedback timeout in ms (default: 2 seconds)
# VITE_HOURS_THRESHOLD_FOR_DAY_DISPLAY=24   # Hours before showing days (default: 24)

# Debug Configuration
# VITE_CONSOLE_LOG_PROBABILITY=0.2          # Probability of logging polls (0-1, default: 0.2 = 20%)
