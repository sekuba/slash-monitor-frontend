# Install as /etc/slashmon-backend-testing.env with mode 0600.
# This profile is intended for an SSH-tunnelled frontend at localhost:5173.
SLASHMON_NETWORK=mainnet
SLASHMON_PUBLIC_URL=http://localhost:5173
BACKEND_CORS_ORIGIN=http://localhost:5173
BACKEND_TRUST_PROXY=false

# Public node RPC and private admin RPC for the same Aztec node.
AZTEC_NODE_URL=http://127.0.0.1:8080
AZTEC_NODE_API_KEY=
AZTEC_ADMIN_URL=http://127.0.0.1:8880
AZTEC_ADMIN_API_KEY=

# Comma-separated Ethereum RPCs. Ten thousand blocks gives a fresh testing
# database enough history to exercise confirmed-slash decoding.
L1_RPC_URL=http://127.0.0.1:8545
# L1_REGISTRY_ADDRESS=
L1_SLASH_LOG_LOOKBACK_BLOCKS=10000

# Keep production providers out of the sidecar. Fill these only with separate
# testing credentials when exercising notification delivery.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
VAPID_SUBJECT=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# --parallel enforces these isolation values even if this file is copied.
BACKEND_BIND_HOST=127.0.0.1
BACKEND_PORT=8791
BACKEND_LOG_LEVEL=info
