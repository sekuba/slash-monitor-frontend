# Slashmon v2 production configuration.
# Install as /etc/slashmon-backend.env with mode 0600.
# The systemd unit pins COLLECTOR_DATABASE_PATH to the existing v1 state file.

SLASHMON_NETWORK=mainnet
# Full installed PWA URL on a dedicated origin. Shared GitHub project Pages are
# public-monitor-only because sibling paths can read origin-wide browser state.
SLASHMON_PUBLIC_URL=https://slashmon.example

# Node identity JSON-RPC plus the private admin JSON-RPC for that same node.
# Neither needs public ingress. Slashmon checks chain, Registry, and canonical
# Rollup before polling; endpoint co-location remains an operator invariant.
AZTEC_NODE_URL=http://127.0.0.1:8080
AZTEC_NODE_API_KEY=
AZTEC_ADMIN_URL=http://127.0.0.1:8880
AZTEC_ADMIN_API_KEY=

# Ethereum execution RPC and canonical Aztec Registry.
# Testnet is Sepolia: L1_CHAIN_ID=11155111 and Registry
# 0xA0BFb1B494FB49041e5c6e8c2C1BE09cD171c6Ba.
L1_RPC_URL=http://127.0.0.1:8545
L1_CHAIN_ID=1
L1_REGISTRY_ADDRESS=0x35b22e09Ee0390539439E24f06Da43D83f90e298
L1_CONFIRMATIONS=2

# Loopback HTTP; terminate HTTPS and rate-limit public writes at the proxy.
# CORS is the PWA origin only, even when SLASHMON_PUBLIC_URL has a path.
COLLECTOR_BIND_HOST=127.0.0.1
COLLECTOR_PORT=8790
COLLECTOR_CORS_ORIGIN=https://slashmon.example
API_MAX_REQUEST_BODY_BYTES=65536
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX_MUTATIONS=60
# The supported deployment has one local reverse proxy which overwrites
# X-Real-IP / X-Forwarded-For before forwarding to this loopback listener.
API_TRUST_LOOPBACK_PROXY=true
MAX_SEQUENCERS_PER_WATCHLIST=100

# Source timing and defensive limits.
COLLECTOR_POLL_INTERVAL_MS=15000
COLLECTOR_MAX_BACKOFF_MS=60000
COLLECTOR_REQUEST_TIMEOUT_MS=10000
COLLECTOR_STALE_AFTER_MS=60000
AZTEC_SYNC_MAX_L1_AGE_MS=300000
AZTEC_SYNC_MAX_L2_STALL_MS=300000
COLLECTOR_WITHDRAW_AFTER_MISSED_POLLS=3
COLLECTOR_MAX_OFFENSES_PER_POLL=100000
COLLECTOR_MAX_RESPONSE_BYTES=2097152
L1_POLL_INTERVAL_MS=30000
L1_MAX_BACKOFF_MS=120000
L1_REQUEST_TIMEOUT_MS=15000
L1_SNAPSHOT_TIMEOUT_MS=120000
L1_STALE_AFTER_MS=120000
L1_MAX_HEAD_AGE_MS=900000
L1_MAX_HEAD_STALL_MS=120000
L1_MAX_FUTURE_SKEW_MS=120000
# Confirmed Slashed-event journal. Initial history is intentionally bounded;
# every later chunk resumes from a SQLite block/hash checkpoint. Keep the
# rewind comfortably above the confirmation-depth reorg you intend to tolerate.
L1_SLASH_LOG_LOOKBACK_BLOCKS=50000
L1_SLASH_LOG_CHUNK_SIZE=2000
L1_SLASH_LOG_OVERLAP_BLOCKS=12
L1_SLASH_LOG_REORG_REWIND_BLOCKS=512
L1_SLASH_LOG_MAX_CHUNKS_PER_POLL=25
L1_SLASH_LOG_PROVIDER_TIMEOUT_MS=5000
L1_SLASH_LOG_MAX_RUN_MS=20000

# Telegram is optional. Create the bot with BotFather and keep this token secret.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_POLL_TIMEOUT_SECONDS=25
TELEGRAM_LINK_TTL_MS=600000

# Web Push is optional. Generate one stable VAPID keypair and keep the private
# key for as long as subscriptions should remain valid.
VAPID_SUBJECT=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Example subject when enabling it: mailto:operator@example.com

# Delivery worker and retry knobs. Batch size caps work per pass; concurrency
# caps each freshly claimed wave. The lease must cover the request timeout plus
# one poll interval. The attempt cap applies to info/test traffic; critical
# alerts retry for 7 days and warnings for 24 hours. Conservative retention
# windows are fixed in code so an env edit cannot prune live work.
DELIVERY_POLL_INTERVAL_MS=1000
DELIVERY_BATCH_SIZE=50
DELIVERY_CONCURRENCY=8
DELIVERY_MAX_ATTEMPTS=12
DELIVERY_LEASE_MS=120000
DELIVERY_REQUEST_TIMEOUT_MS=15000

COLLECTOR_LOG_LEVEL=info
