# Slashmon identity and full installed PWA URL. A path such as /slashmon/ is
# allowed and is preserved in Telegram notification links.
SLASHMON_NETWORK=mainnet
SLASHMON_PUBLIC_URL=http://localhost:5173

# Aztec identity RPC plus the private admin RPC for the same node. Keep both
# loopback-only; the backend verifies node chain/Registry/Rollup identity before
# trusting offenses, while endpoint co-location remains an operator invariant.
AZTEC_NODE_URL=http://127.0.0.1:8080
AZTEC_NODE_API_KEY=
AZTEC_ADMIN_URL=http://127.0.0.1:8880
AZTEC_ADMIN_API_KEY=

# Ethereum L1. L1_RPC_URL accepts up to ten comma-separated HTTP(S) URLs.
# For SLASHMON_NETWORK=testnet use Sepolia (11155111) and the testnet Registry;
# the backend refuses a chain/network mismatch instead of mislabeling alerts.
L1_RPC_URL=http://127.0.0.1:8545
L1_CHAIN_ID=1
L1_REGISTRY_ADDRESS=0x35b22e09Ee0390539439E24f06Da43D83f90e298
L1_CONFIRMATIONS=2
L1_POLL_INTERVAL_MS=30000
L1_MAX_BACKOFF_MS=120000
L1_REQUEST_TIMEOUT_MS=15000
L1_SNAPSHOT_TIMEOUT_MS=120000
L1_STALE_AFTER_MS=120000
L1_MAX_HEAD_AGE_MS=900000
# Once a previously observed confirmed height stops advancing, tolerate normal
# missed slots for this long before failing over/degrading the L1 source.
L1_MAX_HEAD_STALL_MS=120000
L1_MAX_FUTURE_SKEW_MS=120000
# Durable IStakingCore.Slashed log backfill. The first run scans at most this
# many confirmed blocks; later runs resume from SQLite with a small overlap.
# Ranges are checkpointed one chunk at a time. A detected checkpoint reorg
# rewinds the configured tail. The per-poll work/time caps yield to the next
# fresh L1 state snapshot instead of monopolizing the collector.
L1_SLASH_LOG_LOOKBACK_BLOCKS=50000
L1_SLASH_LOG_CHUNK_SIZE=2000
L1_SLASH_LOG_OVERLAP_BLOCKS=12
L1_SLASH_LOG_REORG_REWIND_BLOCKS=512
L1_SLASH_LOG_MAX_CHUNKS_PER_POLL=25
# Each RPC gets a smaller slice than the total run budget so failover remains
# useful when the first provider hangs rather than returning an error.
L1_SLASH_LOG_PROVIDER_TIMEOUT_MS=5000
L1_SLASH_LOG_MAX_RUN_MS=20000

# Durable SQLite state and node-local offense polling.
COLLECTOR_DATABASE_PATH=./data/offenses.sqlite
COLLECTOR_POLL_INTERVAL_MS=15000
COLLECTOR_MAX_BACKOFF_MS=60000
COLLECTOR_REQUEST_TIMEOUT_MS=10000
COLLECTOR_STALE_AFTER_MS=60000
# A missing offense counts only behind a ready, fresh, non-regressing node
# cursor. Repeated polls at the same L2 slot/epoch never count as new misses.
AZTEC_SYNC_MAX_L1_AGE_MS=300000
AZTEC_SYNC_MAX_L2_STALL_MS=300000
COLLECTOR_WITHDRAW_AFTER_MISSED_POLLS=3
COLLECTOR_MAX_OFFENSES_PER_POLL=100000
COLLECTOR_MAX_RESPONSE_BYTES=2097152

# HTTP API. CORS must be the PWA's exact origin (without its path), not `*`.
COLLECTOR_BIND_HOST=127.0.0.1
COLLECTOR_PORT=8790
COLLECTOR_CORS_ORIGIN=http://localhost:5173
API_MAX_REQUEST_BODY_BYTES=65536
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX_MUTATIONS=60
# Trust client IP headers only from a reverse proxy connected over loopback.
API_TRUST_LOOPBACK_PROXY=false
MAX_SEQUENCERS_PER_WATCHLIST=100

# Telegram is enabled only when both values are present.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_POLL_TIMEOUT_SECONDS=25
TELEGRAM_LINK_TTL_MS=600000

# Web Push is enabled only when all three values are present.
VAPID_SUBJECT=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Example subject when enabling it: mailto:operator@example.com

# Durable delivery worker. Batch size caps work per pass; concurrency caps each
# freshly claimed wave of simultaneous provider requests. The lease must cover
# the request timeout plus one poll interval. The attempt cap applies to
# info/test traffic; critical alerts retry for 7 days and warnings for 24 hours.
DELIVERY_POLL_INTERVAL_MS=1000
DELIVERY_BATCH_SIZE=50
DELIVERY_CONCURRENCY=8
DELIVERY_MAX_ATTEMPTS=12
DELIVERY_LEASE_MS=120000
DELIVERY_REQUEST_TIMEOUT_MS=15000

COLLECTOR_LOG_LEVEL=info
